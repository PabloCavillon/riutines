      "css": ".ds-field{display:grid;gap:8px;font:500 .875rem var(--font-archivo, Archivo), sans-serif;color:var(--foreground,#1e1418)} .ds-input{height:44px;padding:4px 10px;border:1px solid var(--input,#c9bfc8);border-radius:.5rem;background:transparent;font:400 .875rem var(--font-archivo, Archivo), sans-serif;color:var(--foreground,#1e1418);outline:none;transition:border-color .15s,box-shadow .15s} .ds-input::placeholder{color:var(--muted-foreground,#5e4f59)} .ds-input:focus-visible{border-color:var(--malbec,#4a1530);box-shadow:0 0 0 3px rgb(74 21 48 / .5)}"
