    {
      "name": "Fila de estado",
      "kind": "custom",
      "refersTo": "status-button",
      "description": "Fila de Hoy: nombre, palotes de racha y tres botones de 44px; la fila se tiñe con el estado.",
      "html": "<ul class=\"ds-list\"><li class=\"ds-row ds-row-done\"><div class=\"ds-row-text\"><p class=\"ds-row-name\"><span>💧</span> Tomar agua</p><p class=\"ds-row-meta\"><span class=\"ds-row-tally\"><svg viewBox=\"-1 0 24 14\" style=\"height:20px;aspect-ratio:25/14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"><path d=\"M2.4 1.5L1.6 12.5\"/><path d=\"M6.5 1.5L6.5 12.5\"/><path d=\"M11.4 1.5L10.6 12.5\"/><path d=\"M15.4 1.5L15.4 12.5\"/><path d=\"M0 11L17 3\"/></svg></span><span>5 días</span></p></div><div class=\"ds-status\"><button class=\"ds-status-btn ds-on-done\" aria-pressed=\"true\" aria-label=\"Hecho\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3.8 13.2L9.1 18.4L21 3.6\"/></svg></button><button class=\"ds-status-btn\" aria-pressed=\"false\" aria-label=\"No hecho\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.6 3.5L7.8 20.5M3.5 15.8L20.5 7.4\"/></svg></button><button class=\"ds-status-btn\" aria-pressed=\"false\" aria-label=\"Omitido\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.4 4.5L5.2 19.5M11.2 6.2L18.8 12.6L10.6 18.2\"/></svg></button></div></li></ul>",
      "css": ".ds-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--border,#ddd7de);font-family:var(--font-archivo, Archivo), sans-serif;font-variant-numeric:tabular-nums;color:var(--foreground,#1e1418)} .ds-row{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border,#ddd7de);transition:background-color .3s} .ds-row-done{background:var(--done-row,#e8f0e0)} .ds-row-text{flex:1;min-width:0} .ds-row-name{margin:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .ds-row-meta{margin:4px 0 0;display:flex;align-items:center;gap:8px;font-size:.875rem;color:var(--muted-foreground,#5e4f59)} .ds-row-tally{color:var(--malbec,#4a1530);display:inline-flex} .ds-row-tally svg{height:14px} .ds-status{display:flex;gap:6px;flex-shrink:0} .ds-status-btn{display:grid;place-items:center;width:44px;height:44px;border-radius:.4rem;border:1px solid var(--input,#c9bfc8);background:var(--card,#fff);color:var(--muted-foreground,#5e4f59);cursor:pointer;transition:color .15s,background-color .15s,border-color .15s} .ds-status-btn:hover{border-color:var(--malbec,#4a1530);color:var(--malbec,#4a1530)} .ds-status-btn:focus-visible{outline:2px solid var(--malbec,#4a1530);outline-offset:2px} .ds-on-done,.ds-on-done:hover{background:var(--done,#4f7a28);border-color:var(--done,#4f7a28);color:#fff}"
    },
